"u.f2": "མུ་མཐུད་རྒྱུའི་མཉམ་སྦྲེལ།",
"n.card": "འབྲུག་ཁྲིད་ནས་རུ་ནེ་ཟོས་ཏེ་རང་གི་རྔ་མ་མ་སོ་བཏབ་པར་ཆེ་རུ་གཏོང་།",
"n.genre": "སྦྲུལ་གྱི་རྩེད་མོ།",
"n.tag": "འབྲུག་ཁྲིད་ནས། རུ་ནེ་ཟོས།",
"n.desc": "Serpent des Runes: འབྲུག་དང་ལྡན་པའི་སྦྲུལ་གྱི་རྩེད་མོ། རིམ་པ་ ༡༢༠ ནང་རུ་ནེ་ཟོས། གེགས་ལས་གཡོལ་ཏེ་སྲུང་མ་ ༦ ཕམ་པར་བྱེད།",
"n.h2": "འབྲུག་དང་ལྡན་པའི་སྦྲུལ་གྱི་རྩེད་མོ།",
"n.p1": "འབྲུག་ནམ་ཡང་མི་སྡོད། བསྒྱུར་ཆེད་མཛུབ་མོས་འདྲུད། ཆེ་རུ་འགྲོ་ཆེད་རུ་ནེ་ཟོས། རྩིག་པ་དང་རང་གི་ལུས་ལས་གཡོལ།",
"n.p2": "ས་ཁུལ་ ༦ ནང་རིམ་པ་ ༡༢༠། རེ་རེ་དཔོན་པོ་ཞིག་གིས་སྲུང་། མཐུ་ལྡན་རུ་ནེས་དུས་ཚོད་དལ་དུ་གཏོང་། ཁྱོད་འདྲེ་རུ་སྒྱུར་རམ་ཁྱོད་སྲུང་།",
"n.f1": "རིམ་པ་ ༡༢༠ དང་སྲུང་མ་ ༦",
"n.f2": "ནུས་པ་མི་འདྲ་བའི་མཐུ་ལྡན་རུ་ནེ།",
"g.f3": "རྩིས་ཐོ་མི་དགོས། དྲ་རྒྱ་མེད་ཀྱང་རྩེད་ཆོག",
"l.f3": "རྩིས་ཐོ་མི་དགོས། དྲ་རྒྱ་མེད་ཀྱང་རྩེད་ཆོག",
"d.f3": "ཁྱིམ་ཚང་ཡོངས་ཀྱི་ཆེད་སྟབས་བདེའི་རེག་ཚོད།",
"t.f3": "རྩིས་ཐོ་མི་དགོས། དྲ་རྒྱ་མེད་ཀྱང་རྩེད་ཆོག",
"w.f3": "རྩིས་ཐོ་མི་དགོས། དྲ་རྒྱ་མེད་ཀྱང་རྩེད་ཆོག",
"u.f3": "རྩིས་ཐོ་མི་དགོས། དྲ་རྒྱ་མེད་ཀྱང་རྩེད་ཆོག",
"n.f3": "རྩིས་ཐོ་མི་དགོས། དྲ་རྒྱ་མེད་ཀྱང་རྩེད་ཆོག"
}